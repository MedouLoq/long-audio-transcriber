# ── Google Cloud ──────────────────────────────────────────────────
# Service-account JSON kept OUTSIDE the repo; leave empty to use Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCP_PROJECT=your-project-id        # optional if the key file names its project
# BUCKET_NAME=                       # empty = "<project>-transcriber-audio" (created with 1-day auto-delete)
BUCKET_LOCATION=us-central1
VERTEX_LOCATION=global

# ── Model ─────────────────────────────────────────────────────────
MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash
THINKING_LEVEL=LOW
LANGUAGE_HINT=
CHUNK_SECONDS=900
PARALLEL_CHUNKS=3
MAX_UPLOAD_MB=2048

# ── Server ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
JOBS_DIR=./data/jobs
# User accounts: create with `python users.py add <name>` (hashed in data/users.json)
# USERS_FILE=./data/users.json
# Optional legacy single login (plaintext, 12+ chars) — prefer users.py
# APP_USER=
# APP_PASSWORD=
# Jobs created before accounts existed are shown to this user
# LEGACY_OWNER=

# ── Demo ──────────────────────────────────────────────────────────
# DEMO_MODE=true   # simulate the model; no Google Cloud needed
